# Cloudinary tokens for image uplodation
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Port
PORT=8080

# Session secret key
SECRET=your_super_secret_session_key

# To integrate MAPBOX TOKEN 
MAP_TOKEN=your_mapbox_access_token

# Mongodb Atlas
MONGODB_ATLAS=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=appName

# Razorpay Credentials (Sandbox/Test mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Nodemailer SMTP Configuration (optional, falls back to winston logger if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Wanderlust <no-reply@wanderlust.com>

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8081/auth/google/callback


