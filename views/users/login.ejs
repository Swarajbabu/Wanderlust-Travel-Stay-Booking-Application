<% layout('layouts/auth') -%>

<div class="auth-split-layout">
  <!-- Left Column: Travel Hero Showcase -->
  <aside class="auth-hero-pane auth-hero-login" aria-label="Wanderlust Travel Inspiration">
    <!-- Brand Header -->
    <div class="auth-hero-content">
      <a href="/listings" class="auth-hero-brand" title="Return to Wanderlust Explore">
        <div class="brand-icon">
          <i class="fa-solid fa-compass"></i>
        </div>
        <span class="brand-name">wanderlust</span>
        <span class="brand-pill">Luxury Escapes</span>
      </a>
    </div>

    <!-- Center Hero Story -->
    <div class="auth-hero-content auth-hero-story">
      <div class="auth-hero-badge">
        <i class="fa-solid fa-sparkles"></i> Welcome Back, Traveler
      </div>
      <h1>
        Find your sanctuary in the <span class="highlight-text">world's most iconic</span> stays.
      </h1>
      <p>
        Over 10,000 handpicked villas, beachfront retreats, and secluded cabins designed for unforgettable journeys.
      </p>

      <!-- Floating Testimonial Card -->
      <div class="auth-hero-testimonial">
        <div class="auth-testimonial-header">
          <span class="auth-testimonial-location">
            <i class="fa-solid fa-location-dot text-danger"></i> Positano, Amalfi Coast &bull; Clifftop Villa
          </span>
          <span class="auth-testimonial-rating">
            <i class="fa-solid fa-star"></i> 4.98
          </span>
        </div>
        <p class="auth-testimonial-quote">
          "The easiest booking experience and the most breathtaking panoramic ocean view we've ever woken up to. Wanderlust set a new gold standard."
        </p>
        <div class="auth-testimonial-author">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=120&auto=format&fit=crop" alt="Elena Rostova">
          <div>
            <div class="author-name">Elena Rostova</div>
            <div class="author-badge">Verified Guest &bull; Staid 5 nights</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Badges Footer -->
    <div class="auth-hero-content auth-hero-footer">
      <div class="auth-trust-item">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Verified Hosts</span>
      </div>
      <div class="auth-trust-item">
        <i class="fa-solid fa-bolt"></i>
        <span>Instant Confirmation</span>
      </div>
      <div class="auth-trust-item">
        <i class="fa-solid fa-gem"></i>
        <span>Zero Hidden Fees</span>
      </div>
      <div class="auth-trust-item">
        <i class="fa-solid fa-lock"></i>
        <span>256-Bit SSL Security</span>
      </div>
    </div>
  </aside>

  <!-- Right Column: Interactive Auth Form -->
  <main class="auth-form-pane">
    <div class="auth-form-container">
      <!-- Top Bar Navigation -->
      <div class="auth-form-topbar">
        <a href="/listings" class="auth-back-link">
          <i class="fa-solid fa-arrow-left"></i>
          <span>Back to Explore</span>
        </a>
        <a href="/listings" class="auth-mobile-logo">
          <i class="fa-solid fa-compass"></i>
          <span>wanderlust</span>
        </a>
      </div>

      <!-- Segmented Tab Switcher -->
      <div class="auth-tab-switcher" role="tablist">
        <a href="/login" class="auth-tab-item active" role="tab" aria-selected="true">
          <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Log In
        </a>
        <a href="/signup" class="auth-tab-item" role="tab" aria-selected="false">
          <i class="fa-solid fa-user-plus me-1"></i> Create Account
        </a>
      </div>

      <!-- Flash Messages -->
      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <div class="auth-alert auth-alert-success" role="alert">
          <i class="fa-solid fa-circle-check"></i>
          <div><%= success %></div>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <div class="auth-alert auth-alert-danger" role="alert">
          <i class="fa-solid fa-circle-exclamation"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <!-- Heading -->
      <div class="auth-heading">
        <h2>Welcome back</h2>
        <p>Enter your details to access your Wanderlust account</p>
      </div>

      <!-- ⚡ Instant 1-Click Guest Pass (Demo Reviewer) -->
      <a href="/guest-login" class="auth-guest-banner" title="Explore instantly with 1-click Demo account">
        <div class="auth-guest-left">
          <div class="auth-guest-icon">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <div class="auth-guest-info">
            <h5>Instant Guest Demo Pass</h5>
            <p>1-Click reviewer access &bull; No password needed</p>
          </div>
        </div>
        <span class="auth-guest-badge">Instant Access &rarr;</span>
      </a>

      <!-- Google OAuth -->
      <a href="/auth/google" class="btn-google-auth">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#EA4335" d="M12 5.04c1.66 0 3.2.57 4.38 1.69l3.27-3.27C17.68 1.54 14.98 1 12 1 7.35 1 3.37 3.67 1.39 7.56l3.89 3.02c.92-2.77 3.51-4.54 6.72-4.54z"/>
          <path fill="#4285F4" d="M23.49 12.27c0-.81-.07-1.59-.2-2.36H12v4.51h6.43c-.28 1.44-1.09 2.67-2.3 3.49l3.6 2.79c2.1-1.94 3.76-4.8 3.76-8.43z"/>
          <path fill="#FBBC05" d="M5.28 14.54c-.24-.72-.38-1.5-.38-2.3s.14-1.58.38-2.3L1.39 6.92C.5 8.7 0 10.7 0 12.8s.5 4.1 1.39 5.88l3.89-3.14z"/>
          <path fill="#34A853" d="M12 23c3.24 0 5.97-1.07 7.96-2.91l-3.6-2.79c-1.01.68-2.3 1.09-3.96 1.09-3.21 0-5.8-1.77-6.72-4.54L1.39 16.9C3.37 20.78 7.35 23 12 23z"/>
        </svg>
        <span>Continue with Google</span>
      </a>

      <!-- Divider -->
      <div class="auth-divider-line">
        <span>or with credentials</span>
      </div>

      <!-- Login Form -->
      <form action="/login" method="post" class="needs-validation auth-form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Username Input -->
        <div class="auth-field-group">
          <label for="username">Username</label>
          <div class="auth-input-wrapper">
            <span class="auth-input-icon"><i class="fa-solid fa-user"></i></span>
            <input
              type="text"
              name="username"
              id="username"
              class="auth-input-control"
              placeholder="Enter your username"
              required
              autocomplete="username"
            >
          </div>
          <div class="invalid-feedback">Please enter your username.</div>
        </div>

        <!-- Password Input with Eye Toggle -->
        <div class="auth-field-group">
          <div class="auth-label-row">
            <label for="password">Password</label>
            <a href="/forgot-password" class="auth-forgot-link">Forgot password?</a>
          </div>
          <div class="auth-input-wrapper">
            <span class="auth-input-icon"><i class="fa-solid fa-lock"></i></span>
            <input
              type="password"
              name="password"
              id="password"
              class="auth-input-control"
              placeholder="Enter your password"
              required
              autocomplete="current-password"
            >
            <button
              type="button"
              class="auth-input-action toggle-password-btn"
              data-target="password"
              aria-label="Toggle password visibility"
              tabindex="-1"
            >
              <i class="fa-solid fa-eye"></i>
            </button>
          </div>
          <div class="invalid-feedback">Please enter your password.</div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-auth-submit">
          <span class="btn-text">
            <span>Log In to Wanderlust</span>
            <i class="fa-solid fa-arrow-right ms-1"></i>
          </span>
          <span class="btn-spinner d-none">
            <i class="fa-solid fa-circle-notch fa-spin me-2"></i> Logging in...
          </span>
        </button>

        <!-- Secondary Code Link -->
        <div class="auth-secondary-opt">
          <a href="/login/otp/request">
            <i class="fa-solid fa-key me-1"></i> Email me a one-time sign-in code instead
          </a>
        </div>
      </form>

      <!-- Terms Note -->
      <p class="auth-terms-note">
        By continuing, you agree to Wanderlust's
        <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
      </p>
    </div>
  </main>
</div>
