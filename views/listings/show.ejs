<% layout('layouts/boilerplate') -%>
<link rel="stylesheet" href="/css/show.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/airbnb.css">
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = JSON.parse('<%- JSON.stringify(listings.geometry && listings.geometry.coordinates && listings.geometry.coordinates.length === 2 ? listings.geometry.coordinates : [78.4867, 17.3850]) %>');
  const listingTitle = "<%= listings.title %>";
</script>

<div class="row mt-4">
  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12">
    <h2 class="show-title fw-bold mb-3"><%= listings.title %></h2>
  </div>

  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12">
    <div class="card show-card listing-card border-0">
      <img src="<%= listings.image.url %>" class="card-img-top show-img shadow-sm mb-4" alt="Listing-Image">
      <div class="card-body p-0">
        <p class="card-text text-muted mb-2">
          <i class="fa-solid fa-circle-user me-1 text-danger"></i> Hosted by <b><%= listings.owner.username %></b>
        </p>
        <p class="card-text description-text fs-5 text-secondary mb-3">
          <%= listings.description %>
        </p>
        
        <div class="d-flex flex-wrap gap-4 my-4 p-3 bg-light rounded-3 shadow-sm border border-light-subtle">
          <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-indian-rupee-sign text-danger fs-5"></i>
            <div>
              <span class="fw-bold fs-5">&#8377; <%= Number(listings.price).toLocaleString("en-IN") %></span>
              <span class="text-muted"> / night</span>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2 border-start ps-4 mobile-no-border mobile-no-padding">
            <i class="fa-solid fa-location-dot text-danger fs-5"></i>
            <div>
              <span class="fw-semibold"><%= listings.location %>, <%= listings.country %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Booking Form Section -->
  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12 mb-4">
    <div class="card border-0 shadow-sm p-4 bg-white rounded-4 border border-light-subtle">
      <h4 class="fw-bold mb-3"><i class="fa-solid fa-calendar-days text-danger me-2"></i>Book this Stay</h4>
      <form action="/listings/<%= listings._id %>/bookings" method="post" novalidate class="needs-validation">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3 mb-3">
          <div class="col-md-6 col-12">
            <label for="checkIn" class="form-label fw-semibold">Check-In Date</label>
            <input type="text" name="booking[checkIn]" id="checkIn" class="form-control rounded-3" placeholder="Select Date" required readonly>
            <div class="invalid-feedback">Please select a valid check-in date.</div>
          </div>
          <div class="col-md-6 col-12">
            <label for="checkOut" class="form-label fw-semibold">Check-Out Date</label>
            <input type="text" name="booking[checkOut]" id="checkOut" class="form-control rounded-3" placeholder="Select Date" required readonly>
            <div class="invalid-feedback">Please select a valid check-out date.</div>
          </div>
        </div>
        <div id="price-calc-box" class="my-3 p-3 bg-light rounded-3 d-none">
          <div class="d-flex justify-content-between mb-1">
            <span>Price per night:</span>
            <span class="fw-bold">&#8377; <%= Number(listings.price).toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span>Number of nights:</span>
            <span id="calc-nights" class="fw-bold">0</span>
          </div>
          <hr class="my-2">
          <div class="d-flex justify-content-between fs-5 fw-bold text-danger">
            <span>Total Price:</span>
            <span>&#8377; <span id="calc-total">0</span></span>
          </div>
        </div>
        <% if (currUser) { %>
          <button class="btn btn-danger px-4 py-2 w-100 rounded-3 fw-bold shadow-sm">
            <i class="fa-solid fa-credit-card me-2"></i>Book Now
          </button>
        <% } else { %>
          <a href="/login" class="btn btn-outline-danger px-4 py-2 w-100 rounded-3 fw-bold shadow-sm">
            <i class="fa-solid fa-right-to-bracket me-2"></i>Log in to Book
          </a>
        <% } %>
      </form>
    </div>
  </div>

  <% if(currUser && currUser._id.equals(listings.owner._id)) { %>
  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12 mb-4">
    <div class="d-flex align-items-center gap-3">
      <a href="/listings/<%= listings._id %>/edit" class="btn btn-dark edit-btn px-4 py-2 rounded-3 shadow-sm">
        <i class="fa-solid fa-pen-to-square me-2"></i>Edit
      </a>
      <form action="/listings/<%= listings._id %>?_method=DELETE" method="post" class="m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-danger px-4 py-2 rounded-3 shadow-sm">
          <i class="fa-solid fa-trash-can me-2"></i>Delete
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Bookings for this listing (Visible only to owner) -->
  <% if(currUser && currUser._id.equals(listings.owner._id) && typeof bookings !== 'undefined' && bookings.length > 0) { %>
  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12 mb-4">
    <div class="card border-0 shadow-sm p-4 bg-white rounded-4 border border-light-subtle">
      <h4 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-list-check text-danger me-2"></i>Bookings for this Listing</h4>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="fw-semibold">Guest</th>
              <th scope="col" class="fw-semibold">Email</th>
              <th scope="col" class="fw-semibold">Check-In</th>
              <th scope="col" class="fw-semibold">Check-Out</th>
              <th scope="col" class="fw-semibold">Total Price</th>
              <th scope="col" class="fw-semibold">Status</th>
              <th scope="col" class="fw-semibold">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for (let booking of bookings) { %>
              <tr>
                <td><b><%= booking.guest.username %></b></td>
                <td><%= booking.guest.email %></td>
                <td><%= new Date(booking.checkIn).toLocaleDateString("en-IN") %></td>
                <td><%= new Date(booking.checkOut).toLocaleDateString("en-IN") %></td>
                <td>&#8377; <%= Number(booking.totalPrice).toLocaleString("en-IN") %></td>
                <td>
                  <% if (booking.status === "confirmed") { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Confirmed</span>
                  <% } else if (booking.status === "cancelled") { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">Cancelled</span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">Pending</span>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex gap-2">
                    <% if (booking.status === "pending") { %>
                      <form action="/bookings/<%= booking._id %>/confirm?_method=PATCH" method="POST" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-success rounded-pill px-3">Confirm</button>
                      </form>
                    <% } %>
                    <% if (booking.status !== "cancelled") { %>
                      <form action="/bookings/<%= booking._id %>/cancel?_method=PATCH" method="POST" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Cancel</button>
                      </form>
                    <% } else { %>
                      <span class="text-muted small">No actions</span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Review Section -->
  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12 mb-4">
    <hr class="my-4" />
    
    <% if (currUser) { %>
    <div class="card border-0 shadow-sm p-4 mb-4 bg-white rounded-4 border border-light-subtle">
      <h4 class="fw-bold mb-3"><i class="fa-solid fa-star text-warning me-2"></i>Leave a Review</h4>
      <form action="/listings/<%= listings._id %>/reviews" method="post" novalidate class="needs-validation">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label for="rating" class="form-label fw-semibold">Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label fw-semibold">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control rounded-3" placeholder="Write your review here..." required></textarea>
          <div class="invalid-feedback">Please add some comments for review.</div>
        </div>
        <button class="btn btn-outline-dark px-4 py-2 rounded-3 fw-semibold">Submit Review</button>
      </form>
    </div>
    <hr class="my-4" />
    <% } %>

    <!-- Displaying the Stars / Guest Feedback -->
    <% if (listings.reviews.length > 0) { %>
    <h4 class="fw-bold mb-4"><i class="fa-solid fa-comments me-2 text-secondary"></i>Guest Reviews</h4>
    <div class="row g-3">
      <% for(let review of listings.reviews) { %>
      <div class="col-md-6 col-12">
        <div class="card h-100 review-card shadow-sm border-0 rounded-4 p-3 bg-white border border-light-subtle">
          <div class="card-body p-0">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="fw-bold text-dark">
                <i class="fa-regular fa-circle-user me-2 text-danger"></i>@<%= review.author && review.author.username ? review.author.username : "anonymous" %>
              </span>
              <p class="starability-result m-0" data-rating="<%= review.rating %>"></p>
            </div>
            <p class="card-text text-secondary comment-text mb-3">
              <%= review.comment %>
            </p>
          </div>
          <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
          <form action="/listings/<%= listings._id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-outline-danger px-3 rounded-pill">
              <i class="fa-solid fa-trash-can me-1"></i>Delete
            </button>
          </form>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <hr class="my-4" />
    <% } %>
  </div>

  <!-- Map Integration -->
  <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1 col-12 mb-5">
    <h4 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot text-danger me-2"></i>Where you'll be</h4>
    <div id="map" class="shadow-sm rounded-4 border border-light-subtle"></div>
  </div>
</div>

<script src="/js/map.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    const pricePerNight = Number("<%= listings.price %>");

    // Fetch booked dates from the endpoint
    fetch('/listings/<%= listings._id %>/bookings/booked-dates')
      .then(res => res.json())
      .then(bookings => {
        const disableRanges = bookings.map(b => ({
          from: new Date(b.checkIn),
          to: new Date(b.checkOut)
        }));

        const checkInPicker = flatpickr("#checkIn", {
          minDate: "today",
          dateFormat: "Y-m-d",
          disable: disableRanges,
          onChange: function(selectedDates, dateStr, instance) {
            if (selectedDates.length > 0) {
              const nextDay = new Date(selectedDates[0]);
              nextDay.setDate(nextDay.getDate() + 1);
              checkOutPicker.set("minDate", nextDay);
              calculatePrice();
            }
          }
        });

        const checkOutPicker = flatpickr("#checkOut", {
          minDate: new Date().setDate(new Date().getDate() + 1),
          dateFormat: "Y-m-d",
          disable: disableRanges,
          onChange: function(selectedDates, dateStr, instance) {
            calculatePrice();
          }
        });

        function calculatePrice() {
          const checkInVal = checkInPicker.selectedDates[0];
          const checkOutVal = checkOutPicker.selectedDates[0];
          if (checkInVal && checkOutVal) {
            const timeDiff = checkOutVal - checkInVal;
            const nights = Math.max(1, Math.ceil(timeDiff / (1000 * 60 * 60 * 24)));
            const total = nights * pricePerNight;
            
            document.getElementById("calc-nights").innerText = nights;
            document.getElementById("calc-total").innerText = total.toLocaleString("en-IN");
            document.getElementById("price-calc-box").classList.remove("d-none");
          } else {
            document.getElementById("price-calc-box").classList.add("d-none");
          }
        }
      });
</script>
