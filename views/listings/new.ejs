<% layout('layouts/boilerplate') -%>
<link rel="stylesheet" href="/css/listing-form.css">

<div class="listing-form-wrapper">
  <div class="listing-form-card">
    <div class="listing-form-header">
      <i class="fa-solid fa-plus-circle d-block"></i>
      <h3>Create a New Listing</h3>
      <p>Share your space with travellers around the world</p>
    </div>

    <form action="/listings?_csrf=<%= csrfToken %>" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Basic Details -->
      <div class="form-section-title">Basic Details</div>

      <div class="mb-3">
        <label class="form-label form-icon-label" for="title">
          <i class="fa-solid fa-heading"></i> Title
        </label>
        <input type="text" name="listing[title]" id="title" placeholder="e.g. Cozy Beachfront Cottage" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label form-icon-label" for="description">
          <i class="fa-solid fa-align-left"></i> Description
        </label>
        <textarea name="listing[description]" id="description" placeholder="Describe your place — what makes it special?" class="form-control" required></textarea>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>

      <!-- Image Upload -->
      <div class="form-section-title">Photos</div>

      <div class="mb-3 file-upload-area">
        <label class="form-label form-icon-label" for="images">
          <i class="fa-solid fa-images"></i> Upload Listing Photos
        </label>
        <input type="file" name="listing[images]" id="images" class="form-control" accept="image/png,image/jpeg,image/jpg" multiple required>
        <div class="form-text">Select 1 to 10 photos. Fewer than 3? We'll fill the rest of your gallery with default stay photos.</div>
        <div id="imagePreviewGrid" class="image-preview-grid"></div>
      </div>

      <!-- Pricing & Location -->
      <div class="form-section-title">Pricing & Location</div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label class="form-label form-icon-label" for="price">
            <i class="fa-solid fa-indian-rupee-sign"></i> Price / Night
          </label>
          <input type="number" name="listing[price]" id="price" placeholder="e.g. 1200" class="form-control" required>
          <div class="invalid-feedback">Price should be valid.</div>
        </div>

        <div class="mb-3 col-md-8">
          <label class="form-label form-icon-label" for="country">
            <i class="fa-solid fa-globe"></i> Country
          </label>
          <input type="text" name="listing[country]" id="country" placeholder="e.g. India" class="form-control" required>
          <div class="invalid-feedback">Country should be valid.</div>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label form-icon-label" for="location">
          <i class="fa-solid fa-location-dot"></i> Location
        </label>
        <input type="text" name="listing[location]" id="location" placeholder="e.g. Hyderabad, Telangana" class="form-control" required>
        <div class="invalid-feedback">Location should be valid.</div>
      </div>

      <button class="btn btn-listing-submit mt-3">
        <i class="fa-solid fa-paper-plane me-2"></i>Add Your Listing
      </button>
    </form>
  </div>
</div>

<script src="/js/script.js"></script>
<script>
  (() => {
    const input = document.getElementById("images");
    const grid = document.getElementById("imagePreviewGrid");
    if (!input || !grid) return;

    input.addEventListener("change", () => {
      grid.innerHTML = "";
      const files = Array.from(input.files || []).slice(0, 10);
      files.forEach((file) => {
        const url = URL.createObjectURL(file);
        const thumb = document.createElement("div");
        thumb.className = "image-preview-thumb";
        thumb.innerHTML = `<img src="${url}" alt="${file.name}">`;
        grid.appendChild(thumb);
      });
    });
  })();
</script>