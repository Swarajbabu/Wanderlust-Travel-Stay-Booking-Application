<% layout('layouts/boilerplate') -%>
<link rel="stylesheet" href="/css/listing-form.css">

<div class="listing-form-wrapper">
  <div class="listing-form-card">
    <div class="listing-form-header">
      <i class="fa-solid fa-pen-to-square d-block"></i>
      <h3>Edit Your Listing</h3>
      <p>Update the details of your space</p>
    </div>

    <form action="/listings/<%= listings._id %>?_method=PUT" method="post" novalidate class="needs-validation" enctype="multipart/form-data">

      <!-- Basic Details -->
      <div class="form-section-title">Basic Details</div>

      <div class="mb-3">
        <label class="form-label form-icon-label" for="title">
          <i class="fa-solid fa-heading"></i> Title
        </label>
        <input type="text" name="listing[title]" id="title" value="<%= listings.title %>" placeholder="e.g. Cozy Beachfront Cottage" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label form-icon-label" for="description">
          <i class="fa-solid fa-align-left"></i> Description
        </label>
        <textarea name="listing[description]" id="description" placeholder="Describe your place — what makes it special?" class="form-control" required><%= listings.description %></textarea>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>

      <!-- Image -->
      <div class="form-section-title">Image</div>

      <div class="mb-3">
        <label class="form-label form-icon-label">
          <i class="fa-solid fa-photo-film"></i> Current Image
        </label>
        <div>
          <img src="<%= originalImageUrl %>" class="current-img-preview" alt="Current listing image">
        </div>
      </div>

      <div class="mb-3 file-upload-area">
        <label class="form-label form-icon-label" for="image">
          <i class="fa-solid fa-image"></i> Upload New Image
        </label>
        <input type="file" name="listing[image]" id="image" class="form-control">
      </div>

      <!-- Pricing & Location -->
      <div class="form-section-title">Pricing & Location</div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label class="form-label form-icon-label" for="price">
            <i class="fa-solid fa-indian-rupee-sign"></i> Price / Night
          </label>
          <input type="number" name="listing[price]" id="price" value="<%= listings.price %>" placeholder="e.g. 1200" class="form-control" required>
          <div class="invalid-feedback">Price should be valid.</div>
        </div>

        <div class="mb-3 col-md-8">
          <label class="form-label form-icon-label" for="country">
            <i class="fa-solid fa-globe"></i> Country
          </label>
          <input type="text" name="listing[country]" id="country" value="<%= listings.country %>" placeholder="e.g. India" class="form-control" required>
          <div class="invalid-feedback">Country should be valid.</div>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label form-icon-label" for="location">
          <i class="fa-solid fa-location-dot"></i> Location
        </label>
        <input type="text" name="listing[location]" id="location" value="<%= listings.location %>" placeholder="e.g. Hyderabad, Telangana" class="form-control" required>
        <div class="invalid-feedback">Location should be valid.</div>
      </div>

      <button class="btn btn-listing-submit mt-3">
        <i class="fa-solid fa-check me-2"></i>Update Listing
      </button>
    </form>
  </div>
</div>

<script src="/js/script.js"></script>