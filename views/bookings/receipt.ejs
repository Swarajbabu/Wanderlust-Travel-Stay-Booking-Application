<% layout('layouts/boilerplate') -%>
<style>
  @media print {
    .navbar, .site-footer, .no-print { display: none !important; }
    body { background: #fff !important; }
    .receipt-card { box-shadow: none !important; border: 1px solid #ddd !important; }
  }
</style>

<div id="wl-chat-context"
  data-booking-id="<%= booking._id %>"
  data-listing-id="<%= booking.listing ? booking.listing._id : '' %>"
  data-location="<%= booking.listing ? (booking.listing.location || '') : '' %>"
  data-country="<%= booking.listing ? (booking.listing.country || '') : '' %>"
  data-title="<%= booking.listing ? (booking.listing.title || '') : '' %>"
  hidden></div>
<div class="container my-4 mb-5">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 no-print">
    <a href="/bookings" class="btn btn-outline-dark rounded-pill px-3 btn-sm fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i>Back to Bookings
    </a>
    <div class="d-flex gap-2">
      <a href="/itineraries/new?bookingId=<%= booking._id %>" class="btn btn-outline-danger rounded-pill px-3 btn-sm fw-semibold">
        <i class="fa-solid fa-route me-1"></i>AI Planner
      </a>
      <button type="button" onclick="window.print()" class="btn btn-danger rounded-pill px-4 btn-sm fw-semibold shadow-sm">
        <i class="fa-solid fa-print me-1"></i>Print / Save PDF
      </button>
    </div>
  </div>

  <%
    const nights = Math.max(1, Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24)));
    const base = booking.basePrice || Math.round(booking.totalPrice / 1.18);
    const tax = booking.taxAmount || (booking.totalPrice - base);
  %>

  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white receipt-card mx-auto" style="max-width: 780px;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 pb-4 border-bottom">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <i class="fa-solid fa-compass text-danger fs-4"></i>
          <span class="fw-bold fs-4 text-danger">wanderlust</span>
        </div>
        <div class="text-muted small">Official Reservation Receipt</div>
      </div>
      <div class="text-md-end">
        <div class="fw-bold text-dark">Receipt #WL-<%= booking._id.toString().slice(-8).toUpperCase() %></div>
        <div class="text-muted small">Issued: <%= new Date(booking.createdAt || Date.now()).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
        <span class="badge mt-1 rounded-pill px-3 py-1 <%= booking.status === 'confirmed' ? 'bg-success' : (booking.status === 'cancelled' ? 'bg-danger' : 'bg-warning text-dark') %>">
          <%= booking.status.toUpperCase() %>
        </span>
      </div>
    </div>

    <div class="row g-4 py-4 border-bottom">
      <div class="col-md-6">
        <div class="text-uppercase text-muted small fw-bold mb-1">Property</div>
        <div class="fw-bold fs-5 text-dark"><%= booking.listing ? booking.listing.title : 'Stay Reservation' %></div>
        <% if (booking.listing) { %>
          <div class="text-secondary small"><%= booking.listing.location %>, <%= booking.listing.country %></div>
          <% if (booking.listing.owner && booking.listing.owner.username) { %>
            <div class="text-muted small mt-1">Host: <strong><%= booking.listing.owner.username %></strong></div>
          <% } %>
        <% } %>
      </div>
      <div class="col-md-6">
        <div class="text-uppercase text-muted small fw-bold mb-1">Guest Details</div>
        <div class="fw-bold text-dark"><%= booking.guest ? booking.guest.username : 'Guest' %></div>
        <% if (booking.guest && booking.guest.email) { %>
          <div class="text-secondary small"><%= booking.guest.email %></div>
        <% } %>
        <div class="text-muted small mt-1">Guests: <strong><%= booking.guests || 1 %></strong></div>
      </div>
    </div>

    <div class="row g-3 py-4 border-bottom">
      <div class="col-sm-4">
        <div class="text-muted small">Check-In</div>
        <div class="fw-bold text-dark"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
      </div>
      <div class="col-sm-4">
        <div class="text-muted small">Check-Out</div>
        <div class="fw-bold text-dark"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
      </div>
      <div class="col-sm-4">
        <div class="text-muted small">Duration</div>
        <div class="fw-bold text-dark"><%= nights %> Night<%= nights === 1 ? '' : 's' %></div>
      </div>
    </div>

    <div class="py-4">
      <h6 class="fw-bold text-uppercase text-muted small mb-3">Payment Breakdown</h6>
      <div class="d-flex justify-content-between mb-2">
        <span>Stay Accommodation (<%= nights %> night<%= nights === 1 ? '' : 's' %>)</span>
        <span class="fw-semibold">&#8377; <%= Number(base).toLocaleString("en-IN") %></span>
      </div>
      <div class="d-flex justify-content-between mb-2">
        <span>GST & Hospitality Taxes (18%)</span>
        <span class="fw-semibold">&#8377; <%= Number(tax).toLocaleString("en-IN") %></span>
      </div>
      <hr>
      <div class="d-flex justify-content-between fs-5 fw-bold text-dark">
        <span>Total Paid / Due</span>
        <span class="text-danger">&#8377; <%= Number(booking.totalPrice).toLocaleString("en-IN") %></span>
      </div>

      <% if (booking.paymentId) { %>
        <div class="mt-3 p-3 bg-light rounded-3 small">
          <div><strong>Razorpay Payment ID:</strong> <code><%= booking.paymentId %></code></div>
          <% if (booking.razorpayOrderId) { %>
            <div><strong>Order ID:</strong> <code><%= booking.razorpayOrderId %></code></div>
          <% } %>
        </div>
      <% } %>

      <% if (booking.status === "cancelled") { %>
        <div class="alert alert-danger mt-3 mb-0 small rounded-3">
          <div><strong>Cancelled:</strong> <%= booking.cancellationReason || "No reason specified" %></div>
          <% if (booking.refundId) { %>
            <div class="mt-1"><strong>Refund ID:</strong> <code><%= booking.refundId %></code> (<%= booking.refundStatus %> &mdash; &#8377; <%= Number(booking.refundAmount || booking.totalPrice).toLocaleString("en-IN") %>)</div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
