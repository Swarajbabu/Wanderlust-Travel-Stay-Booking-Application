<% layout('layouts/boilerplate') -%>
<div class="container mt-4">
  <h2 class="fw-bold mb-4"><i class="fa-solid fa-plane-departure text-danger me-2"></i>My Bookings</h2>

  <% if (bookings.length === 0) { %>
    <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-4 border border-light-subtle">
      <div class="card-body">
        <i class="fa-regular fa-calendar-xmark text-muted mb-3" style="font-size: 4rem;"></i>
        <h4 class="fw-bold text-secondary">No Bookings Found</h4>
        <p class="text-muted fs-5 mb-4">You haven't booked any stays yet. Start exploring beautiful destinations around the world!</p>
        <a href="/listings" class="btn btn-danger px-4 py-2 rounded-3 fw-bold shadow-sm">
          <i class="fa-solid fa-compass me-2"></i>Explore Stays
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mb-5">
      <% for (let booking of bookings) { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white border border-light-subtle">
            <div class="position-relative" style="height: 200px;">
              <img src="<%= booking.listing.image.url %>" class="w-100 h-100 object-fit-cover" alt="Listing Image">
              <div class="position-absolute top-0 end-0 m-3">
                <% if (booking.status === "confirmed") { %>
                  <span class="badge bg-success border border-success rounded-pill px-3 py-1 shadow-sm">Confirmed</span>
                <% } else if (booking.status === "cancelled") { %>
                  <span class="badge bg-danger border border-danger rounded-pill px-3 py-1 shadow-sm">Cancelled</span>
                <% } else { %>
                  <span class="badge bg-warning text-dark border border-warning rounded-pill px-3 py-1 shadow-sm">Pending</span>
                <% } %>
              </div>
            </div>
            <div class="card-body d-flex flex-column p-4">
              <h5 class="card-title fw-bold text-dark mb-1"><%= booking.listing.title %></h5>
              <p class="card-text text-muted mb-3">
                <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= booking.listing.location %>, <%= booking.listing.country %>
              </p>
              
              <div class="bg-light rounded-3 p-3 mb-3 border border-light-subtle">
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-secondary small fw-semibold">Check-In:</span>
                  <span class="fw-bold text-dark small"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="text-secondary small fw-semibold">Check-Out:</span>
                  <span class="fw-bold text-dark small"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                </div>
              </div>
              
              <% if (booking.status === "cancelled") { %>
                <div class="alert alert-danger-subtle border-danger-subtle py-2 px-3 small rounded-3 mb-3">
                  <div class="fw-bold text-danger mb-1">
                    <i class="fa-solid fa-circle-xmark me-1"></i>Cancelled
                    <% if (booking.cancelledAt) { %>
                      <span class="text-muted fw-normal">on <%= new Date(booking.cancelledAt).toLocaleDateString("en-IN") %></span>
                    <% } %>
                  </div>
                  <% if (booking.cancellationReason) { %>
                    <div class="text-secondary mb-1">
                      <strong>Reason:</strong> <%= booking.cancellationReason %>
                    </div>
                  <% } %>
                  <% if (booking.refundStatus === "processed") { %>
                    <div class="text-success fw-semibold mt-1">
                      <i class="fa-solid fa-money-bill-transfer me-1"></i>Refund of &#8377; <%= Number(booking.refundAmount || booking.totalPrice).toLocaleString("en-IN") %> credited to original payment account
                      <% if (booking.refundId) { %>
                        <span class="text-muted d-block small">(Refund ID: <%= booking.refundId %>)</span>
                      <% } %>
                    </div>
                  <% } else if (booking.refundStatus === "failed") { %>
                    <div class="text-danger fw-semibold mt-1">
                      <i class="fa-solid fa-triangle-exclamation me-1"></i>Refund processing error. Please contact support.
                    </div>
                  <% } else if (booking.paymentId) { %>
                    <div class="text-info fw-semibold mt-1">
                      <i class="fa-solid fa-clock-rotate-left me-1"></i>Refund pending processing
                    </div>
                  <% } %>
                </div>
              <% } %>
              
              <div class="d-flex justify-content-between align-items-center mt-auto">
                <div>
                  <span class="text-muted small d-block">Paid Total</span>
                  <span class="fw-bold fs-5 text-danger">&#8377; <%= Number(booking.totalPrice).toLocaleString("en-IN") %></span>
                </div>
                <div class="d-flex gap-2">
                  <% if (booking.status === "pending") { %>
                    <a href="/bookings/<%= booking._id %>/checkout" class="btn btn-danger btn-sm px-3 rounded-pill fw-bold shadow-sm">
                      Pay Now
                    </a>
                  <% } %>
                  <% if (booking.status !== "cancelled" && new Date(booking.checkIn) > new Date()) { %>
                    <button type="button" class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#cancelModal<%= booking._id %>">
                      Cancel
                    </button>
                  <% } %>
                  <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-dark btn-sm px-3 rounded-pill fw-semibold">
                    View Stay
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% if (booking.status !== "cancelled" && new Date(booking.checkIn) > new Date()) { %>
          <!-- Cancel Booking Modal -->
          <div class="modal fade" id="cancelModal<%= booking._id %>" tabindex="-1" aria-labelledby="cancelModalLabel<%= booking._id %>" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom-0 pb-0">
                  <h5 class="modal-title fw-bold text-danger" id="cancelModalLabel<%= booking._id %>">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Cancel Booking
                  </h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/bookings/<%= booking._id %>/cancel?_method=PATCH" method="POST" class="needs-validation" novalidate>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="modal-body py-3">
                    <p class="text-secondary mb-2">
                      Are you sure you want to cancel your stay at <strong><%= booking.listing.title %></strong>?
                    </p>
                    
                    <% if (booking.status === "confirmed" && booking.paymentId) { %>
                      <div class="alert alert-success d-flex align-items-center py-2 px-3 rounded-3 small mb-3">
                        <i class="fa-solid fa-money-bill-transfer fs-5 text-success me-2"></i>
                        <div>
                          <strong>Refund Notice:</strong> A full refund of <strong>&#8377; <%= Number(booking.totalPrice).toLocaleString("en-IN") %></strong> will be automatically credited to your original payment account.
                        </div>
                      </div>
                    <% } %>

                    <div class="mb-3">
                      <label for="cancellationReason<%= booking._id %>" class="form-label fw-bold small text-dark">
                        Reason for Cancellation <span class="text-danger">*</span>
                      </label>
                      <textarea 
                        class="form-control rounded-3" 
                        id="cancellationReason<%= booking._id %>" 
                        name="cancellationReason" 
                        rows="3" 
                        required 
                        minlength="5" 
                        maxlength="500" 
                        placeholder="Please share the reason for cancelling your booking (minimum 5 characters)..."></textarea>
                      <div class="invalid-feedback">
                        Please provide a cancellation reason (at least 5 characters).
                      </div>
                    </div>
                  </div>
                  <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Keep Booking</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                      <i class="fa-solid fa-xmark me-1"></i>Confirm Cancellation
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  <% } %>
</div>
